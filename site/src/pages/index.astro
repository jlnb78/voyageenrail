---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import RecitCard from '../components/RecitCard.astro';
import EuropeMap from '../components/EuropeMap.astro';

const allRecits = (await getCollection('recits')).sort(
  (a, b) => b.data.dateTravelled.valueOf() - a.data.dateTravelled.valueOf()
);
const latest = allRecits.slice(0, 3);
const SHOW_INSTAGRAM = true;
---
<BaseLayout title="voyage en rail" description="Récits de voyages en train à travers l'Europe : itinéraires, calculateur coût et CO2, carte des lignes.">
  <Nav current="accueil" />

  <div style="position:relative;padding:34px 40px 0">
    <div style="position:absolute;right:-120px;top:-170px;width:380px;height:380px;border-radius:50%;background:#e1eecc;z-index:-1"></div>
    <div style="position:relative;display:grid;grid-template-columns:1fr 620px;gap:48px;align-items:center">
      <div>
        <span style="display:block;font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:#8c491a;margin-bottom:16px">9 lignes parcourues · {allRecits.length} récits</span>
        <h1 style="font-size:60px;line-height:1.07;margin:0 0 20px;letter-spacing:-.02em"><span style="display:block">L'Europe tient</span><span style="display:block">sur un réseau</span><span style="display:block;color:#8c491a">de rails.</span></h1>
        <p style="font-size:17px;line-height:1.62;max-width:42ch;margin:0 0 24px;color:rgba(32,30,29,.8)">Choisissez une ligne sur la carte : vous verrez les étapes, la durée réelle, le prix constaté et le CO₂ évité par rapport à l'avion. Tous les trajets ont été faits par nous.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a href="/carte" class="btn btn-primary" style="min-height:42px;padding-inline:22px;font-size:15px">Ouvrir la carte</a>
          <a href="/calculateur" class="btn btn-secondary" style="min-height:42px;padding-inline:22px;font-size:15px">Calculer un trajet</a>
        </div>
      </div>
      <div style="border-radius:48px;overflow:hidden;box-shadow:0 12px 32px rgba(46,43,37,.18);background:#f5ead8;height:440px">
        <EuropeMap mode="mini" initialRouteId="iberie" />
      </div>
    </div>
  </div>

  <div style="display:flex;gap:20px;align-items:center;padding:34px 40px 30px;flex-wrap:wrap">
    <div style="width:168px;height:168px;border-radius:50%;background:#fff2eb;display:grid;place-content:center;text-align:center;padding:20px">
      <p style="font-size:38px;margin:0;color:#8c491a">−87 %</p>
      <p style="font-size:12px;line-height:1.35;letter-spacing:.05em;text-transform:uppercase;font-weight:600;margin:8px 0 0;color:rgba(32,30,29,.7)">de CO₂ face à l'avion</p>
    </div>
    <div style="width:148px;height:148px;border-radius:50%;background:#e1eecc;display:grid;place-content:center;text-align:center;padding:18px;transform:translateY(22px)">
      <p style="font-size:34px;margin:0;color:#3d472b">{allRecits.length}</p>
      <p style="font-size:12px;line-height:1.35;letter-spacing:.05em;text-transform:uppercase;font-weight:600;margin:8px 0 0;color:rgba(32,30,29,.7)">récits publiés</p>
    </div>
    <div style="width:152px;height:152px;border-radius:50%;background:#ffe1d0;display:grid;place-content:center;text-align:center;padding:18px">
      <p style="font-size:34px;margin:0;color:#8c491a">18,4k</p>
      <p style="font-size:12px;line-height:1.35;letter-spacing:.05em;text-transform:uppercase;font-weight:600;margin:8px 0 0;color:rgba(32,30,29,.7)">abonnés Instagram</p>
    </div>
    <p style="flex:1;font-size:15px;line-height:1.62;margin:0 0 0 24px;max-width:34ch;color:rgba(32,30,29,.72)">Les calculs s'appuient sur les facteurs d'émission de l'ADEME et de l'AIE. La méthode est publiée, ligne par ligne, sur la page <a href="/a-propos" style="color:#8c491a;font-weight:600">À propos</a>.</p>
  </div>

  <div class="page-pad" style="padding-top:14px;display:flex;align-items:baseline;justify-content:space-between">
    <h2 style="font-size:30px;margin:0">Derniers récits</h2>
    <a href="/recits" style="font-size:14px;font-weight:600;color:#8c491a;text-decoration:none">Tous les récits →</a>
  </div>

  <div class="page-pad" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding-top:20px;padding-bottom:34px">
    {latest.map((recit) => <RecitCard recit={recit} />)}
  </div>

  {SHOW_INSTAGRAM && (
    <div class="page-pad" style="padding-bottom:34px">
      <div style="background:#f0fae1;border-radius:48px;padding:28px 32px">
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:20px;flex-wrap:wrap">
          <div style="width:44px;height:44px;border-radius:50%;overflow:hidden;flex:none;background:var(--color-neutral-300)"></div>
          <div style="flex:1;min-width:200px">
            <h3 style="font-size:22px;margin:0">@voyageenrail</h3>
            <p style="font-size:13px;margin:2px 0 0;color:rgba(32,30,29,.6)">18 412 abonnés · une photo par trajet, la légende dit toujours le prix</p>
          </div>
          <a href="https://instagram.com/voyageenrail" target="_blank" rel="noopener" class="btn btn-secondary">Suivre sur Instagram</a>
        </div>
        <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:14px">
          {Array.from({ length: 6 }).map(() => (
            <div style="border-radius:24px;overflow:hidden;aspect-ratio:1;background:var(--color-neutral-200)" class="washed"></div>
          ))}
        </div>
      </div>
    </div>
  )}

  <Newsletter />
  <Footer />
</BaseLayout>
