---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Timeline from '../components/Timeline.astro';
import EuropeMap from '../components/EuropeMap.astro';
import { ROUTES, getRoute, HUBS } from '../data/routes';
import { NIGHT_TRAIN_EXTRA_HUBS } from '../data/night-trains';
import { calculate, formatEur, formatKg, formatDurationMin } from '../lib/calc';
import { CO2_FACTORS, CAR_G_PER_KM_VEHICLE } from '../data/co2-factors';

const DEFAULT_ROUTE_ID = 'barcelone';
const route = getRoute(DEFAULT_ROUTE_ID)!;
const input = { route, adults: 2, children: 1, travelClass: '2de' as const, roundTrip: true };
const result = calculate(input);
const maxBar = Math.max(result.train.co2Kg, result.avion.co2Kg, result.voiture.co2Kg) || 1;

// Suggestions only — free text is always accepted, resolved live against
// Deutsche Bahn's own station search (src/lib/db-journeys.ts).
const cityHints = [...new Set([...HUBS, ...NIGHT_TRAIN_EXTRA_HUBS].map(([, label]) => label))].sort();
---
<BaseLayout title="Calculateur coût / CO2 — voyage en rail" description="Comparez le coût, la durée et le CO2 d'un trajet en train, en avion et en voiture — l'une de nos lignes ou un point A à un point B de votre choix.">
  <Nav current="calculateur" />

  <datalist id="city-hints">
    {cityHints.map((c) => <option value={c} />)}
  </datalist>

  <div class="page-pad" style="display:grid;grid-template-columns:392px 1fr;gap:36px;padding-top:16px;padding-bottom:36px;align-items:start">

    <form class="card" id="calc-form" style="padding:28px 26px;gap:16px">
      <h2 style="font-size:24px;margin:0">Votre trajet</h2>

      <div class="seg" style="width:100%">
        <label class="seg-opt" style="flex:1;justify-content:center"><input type="radio" name="mode" value="curated" checked>Nos lignes</label>
        <label class="seg-opt" style="flex:1;justify-content:center"><input type="radio" name="mode" value="custom">Autre trajet</label>
      </div>

      <div data-mode-panel="curated" class="field">
        <label for="calc-route">Ligne</label>
        <select class="input" id="calc-route" name="route">
          {ROUTES.map((r) => <option value={r.id} selected={r.id === DEFAULT_ROUTE_ID}>{r.name}</option>)}
        </select>
      </div>

      <div data-mode-panel="custom" hidden style="display:flex;flex-direction:column;gap:16px">
        <div class="field">
          <label for="calc-from">Départ</label>
          <input class="input" id="calc-from" type="text" list="city-hints" placeholder="Paris, Lyon, Berlin…" autocomplete="off">
        </div>
        <div class="field">
          <label for="calc-via">Correspondance <span style="font-weight:400;color:rgba(32,30,29,.55)">(optionnel)</span></label>
          <input class="input" id="calc-via" type="text" list="city-hints" placeholder="Laisser vide si direct" autocomplete="off">
        </div>
        <div class="field">
          <label for="calc-to">Arrivée</label>
          <input class="input" id="calc-to" type="text" list="city-hints" placeholder="Barcelone, Vienne, Rome…" autocomplete="off">
        </div>
        <p data-out="customStatus" style="font-size:12px;margin:0;color:rgba(32,30,29,.6)" hidden></p>
      </div>

      <div style="display:flex;gap:12px">
        <div class="field" style="flex:1"><label for="calc-depart">Aller</label><input class="input" id="calc-depart" type="date"></div>
        <div class="field" style="flex:1"><label for="calc-retour">Retour <span style="font-weight:400;color:rgba(32,30,29,.55)">(optionnel)</span></label><input class="input" id="calc-retour" type="date"></div>
      </div>
      <div style="display:flex;gap:12px">
        <div class="field" style="flex:1">
          <label for="calc-adults">Adultes</label>
          <input class="input" id="calc-adults" type="number" min="1" max="6" value="2">
        </div>
        <div class="field" style="flex:1">
          <label for="calc-children">Enfants</label>
          <input class="input" id="calc-children" type="number" min="0" max="6" value="1">
        </div>
      </div>
      <div class="field">
        <label>Classe</label>
        <div class="seg" style="width:100%">
          <label class="seg-opt" style="flex:1;justify-content:center"><input type="radio" name="cls" value="2de" checked>2ᵈᵉ</label>
          <label class="seg-opt" style="flex:1;justify-content:center"><input type="radio" name="cls" value="1re">1ʳᵉ</label>
        </div>
      </div>
      <div style="margin-top:4px">
        <p style="font-size:12px;margin:0 0 8px;color:rgba(32,30,29,.7)">Comparer avec</p>
        <div style="display:flex;gap:16px;flex-wrap:wrap">
          <label class="radio"><input type="radio" name="cmp" value="avion"><span class="dot"></span>Avion</label>
          <label class="radio"><input type="radio" name="cmp" value="voiture"><span class="dot"></span>Voiture</label>
          <label class="radio"><input type="radio" name="cmp" value="both" checked><span class="dot"></span>Les deux</label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-block" id="calc-submit" style="min-height:44px;margin-top:10px">Recalculer</button>
      <p style="font-size:11.5px;line-height:1.5;margin:6px 0 0;color:rgba(32,30,29,.55)" data-out="priceNote">Prix relevés le 2 mars 2026 sur les sites des opérateurs. Ils bougent ; c'est une estimation honnête, pas un devis.</p>
    </form>

    <div style="display:flex;flex-direction:column;gap:24px">

      <div id="calc-route-map" style="height:240px;border-radius:36px;overflow:hidden;box-shadow:0 3px 10px rgba(46,43,37,.14)">
        <EuropeMap mode="mini" initialRouteId={DEFAULT_ROUTE_ID} />
      </div>
      <p data-out="estimateNote" style="font-size:11.5px;margin:-14px 4px 0;color:rgba(32,30,29,.55)" hidden></p>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px">
        <div style="background:#ebddc5;border-radius:36px;padding:24px 26px">
          <p style="font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:600;margin:0 0 10px;color:rgba(32,30,29,.6)">Coût total, <span data-out="travelers">{result.travelers}</span> voyageurs</p>
          <p style="font-size:42px;margin:0;line-height:1" data-out="cost">{formatEur(result.train.priceEur)}</p>
          <p style="font-size:13.5px;margin:8px 0 0;color:rgba(32,30,29,.7)"><span data-out="tripLabel">Aller-retour</span>, <span data-out="classLabel">2ᵈᵉ</span> classe, tarif réservé 3 semaines avant.</p>
        </div>
        <div style="background:#f0fae1;border-radius:36px;padding:24px 26px">
          <p style="font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:600;margin:0 0 10px;color:rgba(32,30,29,.6)">CO₂ évité</p>
          <p style="font-size:42px;margin:0;line-height:1;color:#3d472b"><span data-out="co2avoided">{Math.round(result.co2AvoidedVsAvionKg)}</span> kg</p>
          <p style="font-size:13.5px;margin:8px 0 0;color:rgba(32,30,29,.7)">Par rapport au même trajet en avion, pour les <span data-out="travelers2">{result.travelers}</span> voyageurs.</p>
        </div>
        <div style="background:#fff2eb;border-radius:36px;padding:24px 26px">
          <p style="font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:600;margin:0 0 10px;color:rgba(32,30,29,.6)">Durée porte à porte</p>
          <p style="font-size:42px;margin:0;line-height:1;color:#8c491a" data-out="doorToDoor">{formatDurationMin(result.doorToDoorMin)}</p>
          <p style="font-size:13.5px;margin:8px 0 0;color:rgba(32,30,29,.7)">Contre <span data-out="planeDoorToDoor">{formatDurationMin(result.avion.durationOneWayMin + 210)}</span> en avion, transferts et contrôles compris.</p>
        </div>
      </div>

      <div class="card" style="padding:28px 30px;gap:18px">
        <h3 style="font-size:22px;margin:0">Train, avion, voiture</h3>
        <div style="display:flex;flex-direction:column;gap:18px" data-out="bars">
          <div>
            <div style="display:flex;justify-content:space-between;font-size:14px;font-weight:600;margin-bottom:7px"><span>Train — <span data-out="trainDuration">{formatDurationMin(result.train.durationOneWayMin)}</span></span><span data-out="trainStats">{formatKg(result.train.co2Kg)} · {formatEur(result.train.priceEur)}</span></div>
            <div style="height:22px;background:rgba(32,30,29,.07);border-radius:999px;overflow:hidden"><div data-out="trainBar" style={`width:${Math.round((result.train.co2Kg / maxBar) * 100)}%;height:100%;background:#7a8a5e;border-radius:999px`}></div></div>
          </div>
          <div data-bar="avion">
            <div style="display:flex;justify-content:space-between;font-size:14px;font-weight:600;margin-bottom:7px"><span>Avion — <span data-out="avionDuration">{formatDurationMin(result.avion.durationOneWayMin)}</span> de vol</span><span data-out="avionStats">{formatKg(result.avion.co2Kg)} · {formatEur(result.avion.priceEur)}</span></div>
            <div style="height:22px;background:rgba(32,30,29,.07);border-radius:999px;overflow:hidden"><div data-out="avionBar" style={`width:${Math.round((result.avion.co2Kg / maxBar) * 100)}%;height:100%;background:#c67139;border-radius:999px`}></div></div>
          </div>
          <div data-bar="voiture">
            <div style="display:flex;justify-content:space-between;font-size:14px;font-weight:600;margin-bottom:7px"><span>Voiture — <span data-out="voitureDuration">{formatDurationMin(result.voiture.durationOneWayMin)}</span>, <span data-out="voitureKm">{route.carKm}</span> km</span><span data-out="voitureStats">{formatKg(result.voiture.co2Kg)} · {formatEur(result.voiture.priceEur)} (péages et carburant)</span></div>
            <div style="height:22px;background:rgba(32,30,29,.07);border-radius:999px;overflow:hidden"><div data-out="voitureBar" style={`width:${Math.round((result.voiture.co2Kg / maxBar) * 100)}%;height:100%;background:#f6a06b;border-radius:999px`}></div></div>
          </div>
        </div>
        <p style="font-size:12px;line-height:1.5;margin:2px 0 0;color:rgba(32,30,29,.58)">Facteurs ADEME 2025 : {CO2_FACTORS.tgv.gPerKmPax} g CO₂e/km·voyageur en TGV, {CO2_FACTORS.avion.gPerKmPax} g en vol court-courrier avec traînées de condensation, {CO2_FACTORS.voiture.gPerKmPax} g en voiture thermique à 2,2 occupants ({CAR_G_PER_KM_VEHICLE.toFixed(1)} g/km au total du véhicule). <a href="/a-propos" style="color:#8c491a;font-weight:600">Détail du calcul</a></p>
      </div>

      <div class="card" style="padding:28px 30px;gap:16px" data-out="dbcard" hidden>
        <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px">
          <h3 style="font-size:22px;margin:0">Prochains départs réels</h3>
          <span class="text-muted" style="font-size:11px">Recherche Deutsche Bahn — API communautaire, non officielle</span>
        </div>
        <p style="font-size:12.5px;line-height:1.5;margin:0;color:rgba(32,30,29,.65)">Horaires en direct pour vérifier qu'un train existe vraiment à peu près à cette heure — ça ne remplace pas la réservation, et certains trajets (hors réseau indexé par Deutsche Bahn) ne remontent aucun résultat même s'ils existent.</p>
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
          <div class="field" style="flex:1;min-width:200px;margin:0">
            <label for="db-when">À partir de</label>
            <input class="input" id="db-when" type="datetime-local">
          </div>
          <button type="button" class="btn btn-secondary" id="db-search" style="min-height:36px">Chercher</button>
        </div>
        <div data-out="dbResults" style="display:flex;flex-direction:column;gap:10px"></div>
      </div>

      <div class="card" style="padding:28px 30px;gap:20px" data-out="itinCard">
        <div style="display:flex;align-items:baseline;justify-content:space-between">
          <h3 style="font-size:22px;margin:0">L'itinéraire, étape par étape</h3>
          <span class="tag tag-accent-2" data-out="stopCount">{route.itinerary.filter((s) => s.kind === 'stop').length} changement{route.itinerary.filter((s) => s.kind === 'stop').length > 1 ? 's' : ''} recommandé{route.itinerary.filter((s) => s.kind === 'stop').length > 1 ? 's' : ''}</span>
        </div>
        <div data-out="itinerary">
          <Timeline steps={route.itinerary} />
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:4px">
          <button type="button" class="btn btn-primary">Réserver chez l'opérateur</button>
          <button type="button" class="btn btn-secondary">Enregistrer l'itinéraire</button>
          <a href="#" class="btn btn-ghost" data-out="recitLink" hidden>Lire le récit de cette ligne</a>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { ROUTES, getRoute } from '../data/routes';
  import { calculate, formatEur, formatKg, formatDurationMin, estimateRouteFromDistance, type RouteEstimateInput } from '../lib/calc';
  import { findJourneys, findJourneysWithVia, findStation, haversineKm, type JourneySummary } from '../lib/db-journeys';

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const routeSelect = document.getElementById('calc-route') as HTMLSelectElement;
  const adultsInput = document.getElementById('calc-adults') as HTMLInputElement;
  const childrenInput = document.getElementById('calc-children') as HTMLInputElement;
  const departInput = document.getElementById('calc-depart') as HTMLInputElement;
  const retourInput = document.getElementById('calc-retour') as HTMLInputElement;
  const fromInput = document.getElementById('calc-from') as HTMLInputElement;
  const viaInput = document.getElementById('calc-via') as HTMLInputElement;
  const toInput = document.getElementById('calc-to') as HTMLInputElement;
  const submitBtn = document.getElementById('calc-submit') as HTMLButtonElement;

  // Slugs that actually have a récit — kept in sync manually since content
  // collections aren't reachable from a browser-side script.
  const RECIT_BY_ROUTE: Record<string, string> = {
    nightjet: 'paris-vienne-couchette',
    riviera: 'marseille-genes-ligne-lente',
    iberie: 'paris-lisbonne-sans-decoller',
    italie: 'zurich-rome-deux-enfants',
    nord: 'amsterdam-stockholm-deux-jours',
    danube: 'vienne-zagreb-alpes-juliennes',
  };

  const out = (name: string) => document.querySelector(`[data-out="${name}"]`) as HTMLElement | null;

  function currentMode(): 'curated' | 'custom' {
    return (form.querySelector('input[name="mode"]:checked') as HTMLInputElement)?.value === 'custom' ? 'custom' : 'curated';
  }
  function currentClass(): '2de' | '1re' {
    return (form.querySelector('input[name="cls"]:checked') as HTMLInputElement)?.value === '1re' ? '1re' : '2de';
  }
  function currentCmp(): 'avion' | 'voiture' | 'both' {
    return (form.querySelector('input[name="cmp"]:checked') as HTMLInputElement)?.value as 'avion' | 'voiture' | 'both' ?? 'avion';
  }
  function isRoundTrip(): boolean {
    return !!retourInput.value;
  }
  function fmtDateFr(value: string): string {
    if (!value) return '';
    return new Date(`${value}T12:00:00`).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function toDateInputValue(d: Date): string {
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  }
  function toLocalDatetimeValue(d: Date): string {
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  let lastMapRouteId: string | null = null;
  function syncRouteMap(routeId: string | null) {
    if (routeId === lastMapRouteId) return;
    lastMapRouteId = routeId;
    document.querySelector('#calc-route-map .evr-map')
      ?.dispatchEvent(new CustomEvent('evr-set-route', { detail: { id: routeId } }));
  }
  function syncCustomMapLine(points: [number, number][] | null) {
    document.querySelector('#calc-route-map .evr-map')
      ?.dispatchEvent(new CustomEvent('evr-set-custom-line', { detail: { points } }));
  }

  // --- shared output rendering (both modes feed this) ---
  function applyResult(result: ReturnType<typeof calculate>, carKm: number) {
    const cmp = currentCmp();
    const maxBar = Math.max(result.train.co2Kg, result.avion.co2Kg, result.voiture.co2Kg) || 1;

    out('travelers')!.textContent = String(result.travelers);
    out('travelers2')!.textContent = String(result.travelers);
    out('cost')!.textContent = formatEur(result.train.priceEur);
    out('tripLabel')!.textContent = isRoundTrip() ? 'Aller-retour' : 'Aller simple';
    out('classLabel')!.textContent = currentClass() === '1re' ? '1ʳᵉ' : '2ᵈᵉ';
    (out('co2avoided') as HTMLElement).textContent = String(Math.round(result.co2AvoidedVsAvionKg));
    out('doorToDoor')!.textContent = formatDurationMin(result.doorToDoorMin);
    out('planeDoorToDoor')!.textContent = formatDurationMin(result.avion.durationOneWayMin + 210);

    out('trainDuration')!.textContent = formatDurationMin(result.train.durationOneWayMin);
    out('trainStats')!.textContent = `${formatKg(result.train.co2Kg)} · ${formatEur(result.train.priceEur)}`;
    (out('trainBar') as HTMLElement).style.width = `${Math.round((result.train.co2Kg / maxBar) * 100)}%`;

    out('avionDuration')!.textContent = formatDurationMin(result.avion.durationOneWayMin);
    out('avionStats')!.textContent = `${formatKg(result.avion.co2Kg)} · ${formatEur(result.avion.priceEur)}`;
    (out('avionBar') as HTMLElement).style.width = `${Math.round((result.avion.co2Kg / maxBar) * 100)}%`;

    out('voitureDuration')!.textContent = formatDurationMin(result.voiture.durationOneWayMin);
    out('voitureKm')!.textContent = String(Math.round(carKm));
    out('voitureStats')!.textContent = `${formatKg(result.voiture.co2Kg)} · ${formatEur(result.voiture.priceEur)} (péages et carburant)`;
    (out('voitureBar') as HTMLElement).style.width = `${Math.round((result.voiture.co2Kg / maxBar) * 100)}%`;

    document.querySelector('[data-bar="avion"]')!.toggleAttribute('hidden', !(cmp === 'avion' || cmp === 'both'));
    document.querySelector('[data-bar="voiture"]')!.toggleAttribute('hidden', !(cmp === 'voiture' || cmp === 'both'));
  }

  function renderItinerary(steps: import('../data/routes').ItineraryStep[]) {
    const wrap = out('itinerary')!;
    wrap.innerHTML = '';
    const list = document.createElement('div');
    list.style.display = 'flex';
    list.style.flexDirection = 'column';
    steps.forEach((step, i) => {
      const isLast = i === steps.length - 1;
      const size = step.kind === 'stop' ? 10 : 14;
      const filled = step.kind !== 'depart';
      const row = document.createElement('div');
      row.style.display = 'grid';
      row.style.gridTemplateColumns = '74px 22px 1fr';
      row.style.gap = '18px';
      row.innerHTML = `
        <div style="text-align:right;font-size:14px"><p style="font-weight:700;margin:0">${step.time}</p><p style="margin:2px 0 0;color:rgba(32,30,29,.55)">${step.place}</p></div>
        <div style="position:relative">
          ${isLast ? '' : `<div style="position:absolute;left:50%;top:${step.kind === 'depart' ? '7px' : '0'};bottom:-6px;width:3px;transform:translateX(-50%);background:#c67139"></div>`}
          <div style="position:relative;width:${size}px;height:${size}px;margin:${step.kind === 'stop' ? '7px' : '5px'} auto 0;border-radius:50%;background:${filled ? '#c67139' : '#f5ead8'};border:${step.kind === 'stop' ? '0' : '3px solid #c67139'}"></div>
        </div>
        <div style="${isLast ? '' : 'padding-bottom:26px'}">
          <p style="font-weight:700;font-size:15px;margin:0 0 3px">${step.title}</p>
          <p style="font-size:13.5px;line-height:1.55;margin:0;color:rgba(32,30,29,.72)">${step.desc}</p>
        </div>`;
      list.appendChild(row);
    });
    wrap.appendChild(list);
  }

  // --- mode switching ---
  function applyModeVisibility() {
    const mode = currentMode();
    document.querySelectorAll<HTMLElement>('[data-mode-panel]').forEach((el) => {
      el.hidden = el.dataset.modePanel !== mode;
    });
    out('itinCard')!.hidden = mode === 'custom';
    out('estimateNote')!.hidden = mode !== 'custom';
    if (mode === 'custom') {
      out('estimateNote')!.textContent = "Trajet personnalisé : distance à vol d'oiseau, estimation approximative — pas d'itinéraire documenté par nous pour cette combinaison.";
    }
  }
  form.querySelectorAll('input[name="mode"]').forEach((el) => el.addEventListener('change', () => {
    applyModeVisibility();
    out('dbcard')!.hidden = true;
    out('dbResults')!.innerHTML = '';
    if (currentMode() === 'curated') {
      render();
    } else {
      syncCustomMapLine(null);
    }
  }));

  // --- curated mode (one of our 9 lines) ---
  function render() {
    const route = getRoute(routeSelect.value) ?? ROUTES[0];
    syncRouteMap(route.id);
    syncCustomMapLine(null);
    const adults = Math.max(1, parseInt(adultsInput.value || '1', 10));
    const children = Math.max(0, parseInt(childrenInput.value || '0', 10));
    const result = calculate({ route, adults, children, travelClass: currentClass(), roundTrip: isRoundTrip() });
    applyResult(result, route.carKm);

    const stops = route.itinerary.filter((s) => s.kind === 'stop').length;
    out('stopCount')!.textContent = `${stops} changement${stops > 1 ? 's' : ''} recommandé${stops > 1 ? 's' : ''}`;
    renderItinerary(route.itinerary);

    const recitLink = out('recitLink') as HTMLAnchorElement;
    const slug = RECIT_BY_ROUTE[route.id];
    recitLink.hidden = !slug;
    if (slug) recitLink.href = `/recits/${slug}`;

    // Real-schedule lookup only makes sense for a route with a single
    // realistic through-journey — see routes.ts for why the multi-day ones
    // don't have dbStations at all.
    out('dbcard')!.hidden = !route.dbStations;
    out('dbResults')!.innerHTML = '';
  }

  // --- custom mode (arbitrary point A to point B, optional stopover) ---
  async function renderCustom() {
    const fromName = fromInput.value.trim();
    const toName = toInput.value.trim();
    const viaName = viaInput.value.trim();
    const statusEl = out('customStatus')!;
    statusEl.hidden = false;

    if (!fromName || !toName) {
      statusEl.textContent = 'Renseignez au moins un départ et une arrivée.';
      return;
    }
    statusEl.textContent = 'Recherche des gares…';
    submitBtn.disabled = true;
    try {
      const [from, via, to] = await Promise.all([
        findStation(fromName),
        viaName ? findStation(viaName) : Promise.resolve(null),
        findStation(toName),
      ]);
      if (!from || !to || (viaName && !via)) {
        statusEl.textContent = `Impossible de trouver ${!from ? `« ${fromName} »` : (viaName && !via) ? `« ${viaName} »` : `« ${toName} »`} — vérifiez l'orthographe ou essayez une gare voisine.`;
        return;
      }
      const directKm = via ? haversineKm(from, via) + haversineKm(via, to) : haversineKm(from, to);
      statusEl.textContent = `${Math.round(directKm)} km à vol d'oiseau, ${from.name} → ${via ? `${via.name} → ` : ''}${to.name}.`;

      const estimateInput: RouteEstimateInput = estimateRouteFromDistance(directKm);
      const adults = Math.max(1, parseInt(adultsInput.value || '1', 10));
      const children = Math.max(0, parseInt(childrenInput.value || '0', 10));
      const result = calculate({ route: estimateInput, adults, children, travelClass: currentClass(), roundTrip: isRoundTrip() });
      applyResult(result, estimateInput.carKm);

      out('recitLink')!.hidden = true;
      syncRouteMap(null);
      const points: [number, number][] = [[from.lon, from.lat], ...(via ? [[via.lon, via.lat] as [number, number]] : []), [to.lon, to.lat]];
      syncCustomMapLine(points);

      // Custom searches always attempt a real schedule — it's the whole point.
      const dbCard = out('dbcard')!;
      dbCard.hidden = false;
      await runDbSearch(fromName, toName, viaName || null);
    } finally {
      submitBtn.disabled = false;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (currentMode() === 'curated') render(); else renderCustom();
  });
  routeSelect.addEventListener('change', () => { if (currentMode() === 'curated') render(); });
  form.querySelectorAll('input[name="cls"], input[name="cmp"]').forEach((el) => el.addEventListener('change', () => {
    if (currentMode() === 'curated') render();
  }));
  retourInput.addEventListener('change', () => { if (currentMode() === 'curated') render(); });

  // --- Live schedule lookup (Deutsche Bahn, best-effort) ---
  const dbWhenInput = document.getElementById('db-when') as HTMLInputElement | null;
  const dbSearchBtn = document.getElementById('db-search') as HTMLButtonElement | null;

  function formatClock(iso: string | null): string {
    if (!iso) return '?';
    return new Date(iso).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
  }

  function renderDbJourneys(journeys: JourneySummary[] | null) {
    const wrap = out('dbResults')!;
    wrap.innerHTML = '';
    if (journeys === null) {
      wrap.innerHTML = `<p style="font-size:13px;margin:0;color:rgba(32,30,29,.6)">Aucun résultat direct trouvé à cette heure — service indisponible, gares non reconnues, ou ce trajet ne passe pas par le réseau que Deutsche Bahn indexe.</p>`;
      return;
    }
    journeys.forEach((j) => {
      const row = document.createElement('div');
      row.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 14px;background:var(--color-bg);border-radius:16px;font-size:13.5px;flex-wrap:wrap';
      const lines = [...new Set(j.legs.map((l) => l.lineName).filter(Boolean))].join(', ');
      row.innerHTML = `
        <span><strong>${formatClock(j.departure)}</strong> → <strong>${formatClock(j.arrival)}</strong></span>
        <span style="color:rgba(32,30,29,.65)">${j.changes} correspondance${j.changes > 1 ? 's' : ''}</span>
        <span style="color:rgba(32,30,29,.65);text-align:right">${lines || '—'}</span>`;
      wrap.appendChild(row);
    });
  }

  async function runDbSearch(fromName: string, toName: string, viaName: string | null) {
    if (!dbWhenInput) return;
    const wrap = out('dbResults')!;
    wrap.innerHTML = `<p style="font-size:13px;margin:0;color:rgba(32,30,29,.6)">Recherche en cours…</p>`;
    if (dbSearchBtn) dbSearchBtn.disabled = true;
    try {
      const whenISO = dbWhenInput.value ? new Date(dbWhenInput.value).toISOString() : new Date().toISOString();
      const journeys = viaName
        ? await findJourneysWithVia(fromName, viaName, toName, whenISO)
        : await findJourneys(fromName, toName, whenISO);
      renderDbJourneys(journeys);
    } finally {
      if (dbSearchBtn) dbSearchBtn.disabled = false;
    }
  }

  dbSearchBtn?.addEventListener('click', () => {
    if (currentMode() === 'curated') {
      const route = getRoute(routeSelect.value) ?? ROUTES[0];
      if (route.dbStations) runDbSearch(route.dbStations.from, route.dbStations.to, null);
    } else {
      const fromName = fromInput.value.trim();
      const toName = toInput.value.trim();
      if (fromName && toName) runDbSearch(fromName, toName, viaInput.value.trim() || null);
    }
  });

  // --- initial state ---
  const today = new Date();
  const defaultDepart = new Date(today.getTime() + 14 * 86_400_000);
  const defaultRetour = new Date(defaultDepart.getTime() + 5 * 86_400_000);
  departInput.value = toDateInputValue(defaultDepart);
  retourInput.value = toDateInputValue(defaultRetour);
  const defaultDepartAt8am = new Date(defaultDepart);
  defaultDepartAt8am.setHours(8, 0, 0, 0);
  if (dbWhenInput) dbWhenInput.value = toLocalDatetimeValue(defaultDepartAt8am);
  departInput.addEventListener('change', () => {
    if (dbWhenInput && departInput.value) {
      const d = new Date(`${departInput.value}T08:00`);
      dbWhenInput.value = toLocalDatetimeValue(d);
    }
    if (currentMode() === 'curated') render();
  });

  applyModeVisibility();

  // Land here from a récit or the map with ?route=nightjet and it's honoured
  // immediately, no reload needed.
  const params = new URLSearchParams(location.search);
  const wantedRoute = params.get('route');
  if (wantedRoute && getRoute(wantedRoute)) routeSelect.value = wantedRoute;
  render();
</script>
