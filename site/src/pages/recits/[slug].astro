---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Newsletter from '../../components/Newsletter.astro';
import Timeline from '../../components/Timeline.astro';
import { getRoute } from '../../data/routes';

export async function getStaticPaths() {
  const recits = await getCollection('recits');
  return recits.map((recit) => ({ params: { slug: recit.slug }, props: { recit } }));
}

const { recit } = Astro.props;
const { Content } = await render(recit);
const d = recit.data;
const route = getRoute(d.routeId);
const dateLabel = d.dateTravelled.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const updatedLabel = d.dateUpdated?.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });
---
<BaseLayout title={`${d.title} — voyage en rail`} description={d.excerpt}>
  <Nav current="recits" />

  <div style="max-width:820px" class="page-pad">
    <span style="display:block;font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:#8c491a;margin-bottom:14px">{d.kickerType} · {d.country} · voyage du {dateLabel}</span>
    <h1 style="font-size:50px;line-height:1.08;margin:0 0 18px;letter-spacing:-.02em">{d.title}</h1>
    <p style="font-size:19px;line-height:1.6;margin:0 0 18px;color:rgba(32,30,29,.8)">{d.excerpt}</p>
    <div style="display:flex;gap:18px;align-items:center;font-size:13.5px;color:rgba(32,30,29,.6);padding-bottom:22px;flex-wrap:wrap">
      <span>{d.readMinutes} min de lecture</span>
      {updatedLabel && <><span>·</span><span>Mis à jour le {updatedLabel}</span></>}
      <span>·</span><span>−{d.co2AvoidedKg} kg CO₂ face à l'avion</span>
    </div>
  </div>

  <div class="page-pad" style="padding-bottom:30px">
    <figure class="washed" style="margin:0;border-radius:48px;overflow:hidden;background:var(--color-neutral-200)">
      {d.coverImage ? (
        <img src={d.coverImage} alt={d.coverAlt} style="width:100%;height:420px;object-fit:cover;display:block">
      ) : (
        <div style="width:100%;height:420px;display:flex;align-items:center;justify-content:center;color:color-mix(in srgb, var(--color-text) 45%, transparent)">{d.coverAlt}</div>
      )}
    </figure>
  </div>

  <div class="page-pad" style="display:grid;grid-template-columns:1fr 360px;gap:52px;padding-bottom:34px;align-items:start">
    <article class="recit-body" style="font-size:17px;line-height:1.72">
      <Content />
    </article>

    <div style="display:flex;flex-direction:column;gap:22px;position:sticky;top:20px">
      {route && (
        <div style="background:#ebddc5;border-radius:36px;padding:24px 24px 26px">
          <p style="font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:600;margin:0 0 14px;color:rgba(32,30,29,.6)">L'itinéraire de ce récit</p>
          <Timeline steps={route.itinerary} compact />
          <div style="display:flex;flex-direction:column;gap:9px;margin-top:16px">
            <a href={`/calculateur?route=${route.id}`} class="btn btn-primary btn-block" style="margin:0">Calculer pour mes dates</a>
            <a href={`/carte?route=${route.id}`} class="btn btn-secondary btn-block" style="margin:0">Voir la ligne sur la carte</a>
          </div>
        </div>
      )}

      {d.instagramCaption && (
        <div style="background:#f0fae1;border-radius:36px;padding:22px 22px 24px">
          <div style="display:flex;align-items:center;gap:11px;margin-bottom:14px">
            <div style="width:34px;height:34px;border-radius:50%;overflow:hidden;flex:none;background:var(--color-neutral-300)"></div>
            <div><p style="font-weight:700;font-size:13.5px;margin:0">@voyageenrail</p><p style="font-size:12px;margin:0;color:rgba(32,30,29,.6)">{d.instagramDate}</p></div>
          </div>
          <div class="washed" style="border-radius:24px;overflow:hidden;aspect-ratio:1;background:var(--color-neutral-200)"></div>
          <p style="font-size:13px;line-height:1.55;margin:12px 0 0;color:rgba(32,30,29,.75)">{d.instagramCaption}</p>
        </div>
      )}
    </div>
  </div>

  <Newsletter title="Un récit par mois, avec ses prix relevés" body="Vous recevez le récit du mois et les changements d'horaires utiles. Désinscription en un clic." />
  <Footer />
</BaseLayout>

<style>
  .recit-body :global(p) { margin: 0 0 18px; }
  .recit-body :global(h2) { font-size: 28px; margin: 30px 0 12px; }
  .recit-body :global(blockquote) {
    font-family: var(--font-heading); font-size: 26px; line-height: 1.32; margin: 26px 0;
    padding-left: 24px; border-left: 4px solid #c67139; color: var(--color-text); font-style: normal;
  }
  .recit-body :global(blockquote p) { margin: 0; }
  .recit-body :global(em) { font-style: italic; color: rgba(32,30,29,.7); }
</style>
